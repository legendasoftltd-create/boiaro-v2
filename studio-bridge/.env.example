# LiveKit (matches --dev mode fixed credentials in docker-compose.yml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# RTMP ingest — Egress pushes its mixed output here
RTMP_PORT=1935
# node-media-server also needs an HTTP port even though we don't use its player/API
NMS_HTTP_PORT=8888
# Internal control channel — the app server calls POST /internal/register-mount
# here (before starting Egress) to tell this broadcast which Icecast mount to
# use, so concurrent stations don't collide on ICECAST_MOUNT below. Guarded by
# STUDIO_BRIDGE_INTERNAL_SECRET further down.
BRIDGE_INTERNAL_PORT=8899
# Loopback by default (safe when the app server runs on this same host). If
# the app server is on a DIFFERENT host, set this to 0.0.0.0 and restrict the
# port to that host's IP at the firewall — the shared secret alone isn't a
# substitute for that.
BRIDGE_INTERNAL_HOST=127.0.0.1

# Local dev Icecast (see Dockerfile.icecast) — NOT production credentials
ICECAST_HOST=localhost
ICECAST_PORT=8000
# Fallback mount used only when the app server didn't register a per-station
# mount for this broadcast (e.g. a stationless test broadcast) — see
# BRIDGE_INTERNAL_PORT above for the normal, per-station path.
ICECAST_MOUNT=/studio-test.mp3
ICECAST_SOURCE_PASSWORD=devpassword
# Path to the SAME icecast.xml file bind-mounted into the icecast container
# (see docker-compose.yml) — the bridge rewrites this file directly, then
# reloads Icecast via `docker compose kill -s HUP` (Icecast has no HTTP
# admin command for a live reload; it re-reads its config on SIGHUP, same
# as `systemctl reload icecast2` on a native install). Relative to
# studio-bridge/'s cwd by default. Requires the bridge to run from the same
# directory as docker-compose.yml, with `docker` on PATH.
ICECAST_XML_PATH=./icecast/icecast.xml
# Override if the icecast service is renamed in docker-compose.yml.
ICECAST_COMPOSE_SERVICE=icecast

# Watchdog auto-restart tuning
BRIDGE_MIN_STABLE_MS=10000
BRIDGE_BACKOFF_BASE_MS=1000
BRIDGE_BACKOFF_MAX_MS=30000

# WAV master recording (Phase 3a) — local scratch dir for the second ffmpeg
# output, and how to reach the main server's completion webhook. The shared
# secret must match STUDIO_BRIDGE_INTERNAL_SECRET in server/.env exactly.
STUDIO_MASTER_DIR=/tmp/studio-masters
STUDIO_SERVER_URL=http://localhost:3001
STUDIO_BRIDGE_INTERNAL_SECRET=devInternalSecret

# Emergency Fallback / Playlist Looper (Phase 3b) — always-on standby source
# so listeners never hit dead air when a broadcast drops. Requires
# <fallback-mount> configured on the Icecast side (see icecast/icecast.xml).
ICECAST_FALLBACK_MOUNT=/fallback.mp3
FALLBACK_PLAYLIST_DIR=./fallback-playlist
