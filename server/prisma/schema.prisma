model LiveSession {
  id                String   @id @default(uuid())
  created_at        DateTime @default(now())
  disconnect_reason String?
  ended_at          DateTime?
  rj_user_id        String
  show_title        String?
  started_at        DateTime @default(now())
  station_id        String?
  // scheduled | preparing | testing | live | reconnecting | ended
  status            String   @default("live")
  stream_url        String?
  // Populated either automatically (ffmpeg capture, see lib/liveRecorder.ts)
  // or manually attached by the RJ/admin after the show ends.
  recording_url     String?
  // null (no recording) | recording | processing | draft | published | rejected | deleted
  recording_status         String?
  recording_source         String?   // "automatic" | "manual"
  recording_duration_seconds Int?
  recording_file_size_bytes  Int?
  recording_approved_by    String?
  recording_approved_at    DateTime?
  recording_published_at   DateTime?

  // Private test broadcast — never surfaced in the public "current live"
  // queries, only visible to the host and admins.
  is_test           Boolean  @default(false)
  category          String?
  chat_enabled      Boolean  @default(true)
  requests_enabled  Boolean  @default(true)
  recording_enabled Boolean  @default(true)
  callin_enabled    Boolean  @default(false)
  reaction_count    Int      @default(0)
  catchup_play_count Int     @default(0)

  // Liveness heartbeat from the RJ client — a stale heartbeat past the
  // configured grace period flips status to "reconnecting", then auto-ends
  // the session if it stays stale (see jobs/streamReconnect.ts).
  last_heartbeat_at DateTime @default(now())

  station RadioStation?     @relation(fields: [station_id], references: [id])
  chat_messages     LiveChatMessage[]
  song_requests     SongRequest[]
  listener_sessions ListenerSession[]
  call_ins          CallInRequest[]
  mutes             RadioMute[]
  reports           LiveReport[]
  catchup_progress  CatchupProgress[]
  studio_session    StudioSession?
  icecast_samples   IcecastListenerSample[]

  @@map("live_sessions")
}

// Persisted join/leave per listener — the in-memory Socket.IO room size only
// gives a live count and resets on server restart, so this is the only
// source for accurate unique-listener counts, average duration, and any
// historical analytics once a session has ended.
model ListenerSession {
  id              String    @id @default(uuid())
  live_session_id String
  user_id         String?
  // Privacy-safe anonymous identifier for guests (never a real device
  // fingerprint) — same convention as book view tracking's device_id.
  device_id       String?
  platform        String? // web | android | ios
  // ISO 3166-1 alpha-2, via geoCountry.ts (CF-IPCountry header or geoip-lite
  // fallback) — country-only, no city-level lookup (see plan for why).
  country         String?
  joined_at       DateTime  @default(now())
  left_at         DateTime?
  created_at      DateTime  @default(now())

  session LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade)

  @@index([live_session_id, joined_at])
  @@map("listener_sessions")
}

// Session-scoped chat/request mute — checked before accepting a chat message
// or song request. expires_at null = permanent (until explicitly unmuted).
model RadioMute {
  id              String    @id @default(uuid())
  live_session_id String
  user_id         String
  muted_by        String
  reason          String?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  // "mute" — blocks chat/requests, still able to listen.
  // "ban"  — also removed from the room's interactive layer entirely
  // (can't rejoin the socket room), a heavier tool than a mute.
  type            String    @default("mute")

  session LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade)

  @@index([live_session_id, user_id])
  @@map("radio_mutes")
}

// Per-listener catch-up playback state — powers both "resume where you left
// off" and the catch-up analytics (unique listeners = distinct rows,
// completion rate = % with completed=true). One row per user per recording;
// total_plays increments every time they start it again from the beginning.
model CatchupProgress {
  id               String   @id @default(uuid())
  live_session_id  String
  user_id          String
  position_seconds Int      @default(0)
  duration_seconds Int?
  completed        Boolean  @default(false)
  total_plays      Int      @default(1)
  last_played_at   DateTime @default(now())
  created_at       DateTime @default(now())

  session LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade)

  @@unique([user_id, live_session_id])
  @@index([live_session_id])
  @@map("catchup_progress")
}

// Listener-submitted report on a chat message or song request.
model LiveReport {
  id              String    @id @default(uuid())
  live_session_id String
  reporter_id     String
  target_type     String // chat_message | song_request
  target_id       String
  reason          String
  status          String    @default("pending") // pending | reviewed | dismissed | actioned
  reviewed_by     String?
  reviewed_at     DateTime?
  created_at      DateTime  @default(now())

  session LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@map("live_reports")
}

// Listener call-in state machine — DB/API built per spec even though the
// actual WebRTC audio transport is out of scope for this pass (deferred,
// same as the earlier explicit decision on this feature). Nothing here
// carries audio; it only tracks who asked, who's accepted, and who's on air.
model CallInRequest {
  id               String    @id @default(uuid())
  live_session_id  String
  user_id          String
  // requested | waiting | accepted | rejected | on_air | muted | removed | ended
  status           String    @default("requested")
  requested_at     DateTime  @default(now())
  responded_at     DateTime?
  on_air_at        DateTime?
  ended_at         DateTime?
  consent_given_at DateTime?
  created_at       DateTime  @default(now())

  session LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade)

  @@index([live_session_id, status])
  @@map("call_in_requests")
}

// Approval/status transition history for an RJ — separate from RjProfile's
// current-state fields so admins can see the full timeline (approved,
// rejected, suspended, deactivated, reactivated) and who did it.
model RjApprovalLog {
  id         String   @id @default(uuid())
  rj_user_id String
  action     String // approved | rejected | suspended | deactivated | reactivated
  reason     String?
  actor_id   String
  created_at DateTime @default(now())

  @@index([rj_user_id, created_at])
  @@map("rj_approval_logs")
}

// Live show chat — persisted (unlike reactions, which are ephemeral/socket-only)
// so late joiners can see recent history via REST, and so moderation has
