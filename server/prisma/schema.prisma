generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AppRole {
  admin
  moderator
  user
  writer
  publisher
  narrator
  rj
  translator
}

enum AudioQuality {
  standard
  hd
}

enum BindingType {
  paperback
  hardcover
}

enum BookFormatType {
  ebook
  audiobook
  hardcopy
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password_hash       String
  email_verified      Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  reset_otp           String?
  reset_otp_expires   DateTime?
  // Apple's `sub` claim — the only stable identifier across logins, since Apple
  // omits email/name from the client payload after the first authorization.
  apple_id            String?   @unique

  profile   Profile?
  roles     UserRole[]

  @@map("users")
}

// ─── Tables ──────────────────────────────────────────────────────────────────

model AccountingLedger {
  id             String   @id @default(uuid())
  amount         Float    @default(0)
  book_id        String?
  category       String   @default("general")
  created_at     DateTime @default(now())
  created_by     String?
  description    String?
  entry_date     DateTime @default(now())
  order_id       String?
  reference_id   String?
  reference_type String?
  source         String   @default("system")
  type           String   @default("credit")
  updated_at     DateTime @updatedAt

  @@map("accounting_ledger")
}

model AdBanner {
  id              String   @id @default(uuid())
  clicks          Int?     @default(0)
  created_at      DateTime @default(now())
  destination_url String?
  device          String?
  display_order   Int?
  end_date        DateTime?
  image_url       String?
  impressions     Int?     @default(0)
  placement_key   String
  start_date      DateTime?
  status          String   @default("active")
  title           String?
  updated_at      DateTime @updatedAt
  slides          AdBannerSlide[]

  @@map("ad_banners")
}

// One AdBanner can carry multiple images that slide/rotate in place, each
// with its own click-through destination — legacy AdBanner.image_url /
// destination_url stay populated as a mirror of the first slide so any
// already-shipped mobile app build reading the old flat fields keeps working.
model AdBannerSlide {
  id              String   @id @default(uuid())
  banner_id       String
  image_url       String
  destination_url String?
  display_order   Int      @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  created_at      DateTime @default(now())

  banner AdBanner @relation(fields: [banner_id], references: [id], onDelete: Cascade)

  @@map("ad_banner_slides")
}

model AdCampaign {
  id            String   @id @default(uuid())
  ad_type       String   @default("banner")
  created_at    DateTime @default(now())
  end_date      DateTime?
  name          String
  notes         String?
  placement_key String?
  start_date    DateTime?
  status        String   @default("active")
  target_page   String?
  updated_at    DateTime @updatedAt

  @@map("ad_campaigns")
}

model AdPlacement {
  id                String   @id @default(uuid())
  ad_type           String   @default("banner")
  created_at        DateTime @default(now())
  device_visibility String?
  display_priority  Int?
  frequency         String?
  is_enabled        Boolean  @default(true)
  label             String
  notes             String?
  placement_key     String   @unique
  updated_at        DateTime @updatedAt

  @@map("ad_placements")
}

model AdminActivityLog {
  id          String   @id @default(uuid())
  action      String
  action_type String?
  actor_role  String?
  created_at  DateTime @default(now())
  details     String?
  ip_address  String?
  module      String?
  new_value   String?
  old_value   String?
  risk_level  String   @default("low")
  status      String   @default("success")
  target_id   String?
  target_type String?
  user_agent  String?
  user_id     String
  user_name   String?

  @@map("admin_activity_logs")
}

model AdminRole {
  id          String   @id @default(uuid())
  created_at  DateTime @default(now())
  description String?
  is_system   Boolean  @default(false)
  label       String
  name        String   @unique
  updated_at  DateTime @updatedAt

  admin_user_roles   AdminUserRole[]
  admin_permissions  AdminRolePermission[]

  @@map("admin_roles")
}

model AdminRolePermission {
  id             String   @id @default(uuid())
  admin_role_id  String
  permission_key String
  is_allowed     Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  admin_role AdminRole @relation(fields: [admin_role_id], references: [id], onDelete: Cascade)

  @@unique([admin_role_id, permission_key])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  id            String    @id @default(uuid())
  admin_role_id String
  created_at    DateTime  @default(now())
  is_active     Boolean   @default(true)
  updated_at    DateTime  @updatedAt
  user_id       String

  admin_role AdminRole @relation(fields: [admin_role_id], references: [id])

  @@map("admin_user_roles")
}

model AudiobookTrack {
  id                 String   @id @default(uuid())
  audio_url          String?
  book_format_id     String
  chapter_price      Float?
  chapter_taka_price Float?
  created_at         DateTime @default(now())
  created_by         String?
  duration           String?
  is_preview         Boolean? @default(false)
  media_type         String   @default("audio")
  status             String   @default("active")
  title              String
  track_number       Int
  preview_audio_url  String?

  book_format      BookFormat       @relation(fields: [book_format_id], references: [id], onDelete: Cascade)
  chapter_purchases ChapterPurchase[]

  @@map("audiobook_tracks")
}

model ChapterPurchase {
  id             String   @id @default(uuid())
  book_id        String
  track_id       String
  user_id        String
  price          Float
  payment_method String   @default("sslcommerz")
  payment_status String   @default("pending")
  transaction_id String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  track AudiobookTrack @relation(fields: [track_id], references: [id])

  @@map("chapter_purchases")
}

// Apple/Google in-app purchase transactions (e.g. RevenueCat-verified consumables).
// transaction_id is globally unique so a single receipt can never unlock more
// than one (user, book, track) combination — the core replay-attack defense.
model IapTransaction {
  id             String   @id @default(uuid())
  user_id        String
  book_id        String
  track_id       String?
  product_id     String?
  store          String   @default("app_store")
  transaction_id String   @unique
  raw_response   Json?
  created_at     DateTime @default(now())

  @@index([user_id])
  @@map("iap_transactions")
}

model Author {
  id          String   @id @default(uuid())
  avatar_url  String?
  bio         String?
  created_at  DateTime @default(now())
  email       String?
  genre       String?
  is_featured Boolean? @default(false)
  is_trending Boolean? @default(false)
  linked_at   DateTime?
  name        String
  name_en     String?
  phone       String?
  priority    Int      @default(0)
  status      String   @default("active")
  updated_at  DateTime @updatedAt
  user_id     String?

  books Book[]

  @@map("authors")
}

model Translator {
  id          String   @id @default(uuid())
  avatar_url  String?
  bio         String?
  created_at  DateTime @default(now())
  email       String?
  genre       String?
  is_featured Boolean? @default(false)
  is_trending Boolean? @default(false)
  linked_at   DateTime?
  name        String
  name_en     String?
  phone       String?
  priority    Int      @default(0)
  status      String   @default("active")
  updated_at  DateTime @updatedAt
  user_id     String?

  books Book[]

  @@map("translators")
}

model BadgeDefinition {
  id              String   @id @default(uuid())
  category        String   @default("reading")
  coin_reward     Int?
  condition_type  String   @default("count")
  condition_value Int?
  created_at      DateTime? @default(now())
  description     String?
  icon_url        String?
  is_active       Boolean? @default(true)
  key             String   @unique
  sort_order      Int?
  title           String
  updated_at      DateTime? @updatedAt

  user_badges UserBadge[]

  @@map("badge_definitions")
}

model BlogPost {
  id              String   @id @default(uuid())
  author_name     String?
  category        String?
  content         String   @default("")
  cover_image     String?
  created_at      DateTime @default(now())
  excerpt         String?
  is_featured     Boolean? @default(false)
  publish_date    DateTime?
  seo_description String?
  seo_keywords    String?
  seo_title       String?
  slug            String   @unique
  status          String   @default("draft")
  tags            String[]
  title           String
  updated_at      DateTime @updatedAt

  @@map("blog_posts")
}

model BookComment {
  id         String   @id @default(uuid())
  book_id    String
  comment    String
  created_at DateTime @default(now())
  parent_id  String?
  updated_at DateTime @updatedAt
  user_id    String

  book    Book         @relation(fields: [book_id], references: [id], onDelete: Cascade)
  parent  BookComment? @relation("CommentReplies", fields: [parent_id], references: [id])
  replies BookComment[] @relation("CommentReplies")
  likes   CommentLike[]

  @@map("book_comments")
}

model BookContributor {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  format     String?
  role       String
  user_id    String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("book_contributors")
}

model BookFormat {
  id                          String         @id @default(uuid())
  audio_quality               AudioQuality?
  binding                     BindingType?
  book_id                     String
  chapters_count              Int?
  coin_price                  Int?
  created_at                  DateTime       @default(now())
  default_packaging_cost      Float?
  delivery_days               Int?
  dimensions                  String?
  discount                    Float?
  duration                    String?
  file_size                   String?
  file_url                    String?
  format                      BookFormatType
  in_stock                    Boolean?       @default(true)
  is_available                Boolean?       @default(true)
  isbn                        String?
  subscriber_access           Boolean?       @default(false)
  purchase_allowed            Boolean?       @default(true)
  free_access                 Boolean?       @default(false)
  subscription_delay_days     Int?           @default(0)
  license_start_date          DateTime?
  license_end_date            DateTime?
  rights_status               String         @default("active")
  narrator_id                 String?
  narrator_ids                String[]       @default([])
  original_price              Float?
  pages                       Int?
  payout_model                String         @default("standard")
  preview_chapters            Int?
  preview_percentage          Float?
  price                       Float?
  printing_cost               Float?
  publisher_commission_percent Float?
  publisher_id                String?
  stock_count                 Int?
  submission_status           String         @default("pending")
  submitted_by                String?
  unit_cost                   Float?
  updated_at                  DateTime       @updatedAt
  weight                      String?
  weight_kg_per_copy          Float?

  book            Book             @relation(fields: [book_id], references: [id])
  narrator        Narrator?        @relation(fields: [narrator_id], references: [id])
  publisher       Publisher?       @relation(fields: [publisher_id], references: [id])
  audiobook_tracks AudiobookTrack[]
  ebook_chapters  EbookChapter[]
  order_items     OrderItem[]
  included_plans  BookFormatSubscriptionPlan[]
  early_access    BookFormatEarlyAccess[]

  @@unique([book_id, format])
  @@map("book_formats")
}

model BookFormatSubscriptionPlan {
  id             String   @id @default(uuid())
  book_format_id String
  plan_id        String
  created_at     DateTime @default(now())

  book_format BookFormat       @relation(fields: [book_format_id], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([book_format_id, plan_id])
  @@map("book_format_subscription_plans")
}

model BookFormatEarlyAccess {
  id                  String   @id @default(uuid())
  book_format_id      String
  plan_id             String
  delay_override_days Int?
  created_at          DateTime @default(now())

  book_format BookFormat       @relation(fields: [book_format_id], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([book_format_id, plan_id])
  @@map("book_format_early_access")
}

// One row per user per book — mirrors BookListen. A "read" is only recorded
// once the reader has crossed an engagement threshold (see readTracking.ts),
// and the unique constraint makes repeat engagement for the same user/book
// a no-op, so total_reads reflects unique readers, not open/click events.
model BookRead {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  user_id    String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id])
  @@map("book_reads")
}

// One row per user per book — the unique constraint is what makes "listens"
// a unique-listener count rather than a play-event count (unlike BookRead,
// which intentionally logs every read event with no uniqueness).
model BookListen {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  user_id    String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id])
  @@map("book_listens")
}

// One row per viewer (user_id when logged in, device_id fallback for
// anonymous visitors) per book — tracks Book Details page views with a
// rolling 24h window, not a lifetime unique like BookRead/BookListen: the
// same viewer opening the page again next week is a genuine new view, so
// last_viewed_at is checked and only advanced once >24h has elapsed since
// the previous view (see viewTracking.ts). Exactly one of user_id/device_id
// is set per row — never both — so each unique constraint only dedups
// within its own identity type.
model BookView {
  id             String   @id @default(uuid())
  book_id        String
  user_id        String?
  device_id      String?
  view_count     Int      @default(1)
  last_viewed_at DateTime @default(now())
  created_at     DateTime @default(now())

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, user_id])
  @@unique([book_id, device_id])
  @@map("book_views")
}

model Bookmark {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  user_id    String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model Book {
  id                String   @id @default(uuid())
  author_id         String?
  translator_id     String?
  category_id       String?
  coin_price        Int?
  cover_url         String?
  created_at        DateTime @default(now())
  description       String?
  description_bn    String?
  is_active         Boolean  @default(true)
  is_bestseller     Boolean? @default(false)
  is_featured       Boolean? @default(false)
  is_free           Boolean? @default(false)
  is_new            Boolean? @default(false)
  is_premium        Boolean? @default(false)
  language          String?
  priority          Int?
  published_date    DateTime?
  publisher_id      String?
  rating            Float?
  reviews_count     Int?     @default(0)
  slug              String   @unique
  premium_voice_enabled Boolean? @default(false)
  submission_status String   @default("pending")
  submitted_by      String?
  tags              String[]
  title             String
  title_en          String?
  total_reads       Int?     @default(0)
  total_listens     Int?     @default(0)
  total_views       Int?     @default(0)
  updated_at        DateTime @updatedAt
  subscriber_access Boolean? @default(false)
  voice_access_type String?  @default("paid")
  voice_coin_price  Int?

  author     Author?     @relation(fields: [author_id], references: [id])
  translator Translator? @relation(fields: [translator_id], references: [id])
  category  Category?  @relation(fields: [category_id], references: [id])
  publisher Publisher? @relation(fields: [publisher_id], references: [id])

  formats           BookFormat[]
  comments          BookComment[]
  contributors      BookContributor[]
  reads             BookRead[]
  listens           BookListen[]
  views             BookView[]
  bookmarks         Bookmark[]
  reviews           Review[]
  reading_progress  ReadingProgress[]
  listening_progress ListeningProgress[]
  content_unlocks   ContentUnlock[]
  daily_stats       DailyBookStat[]
  user_presence     UserPresence[]
  coupon_books      CouponBook[]

  @@map("books")
}

model Category {
  id          String   @id @default(uuid())
  color       String?
  created_at  DateTime @default(now())
  icon        String?
  is_featured Boolean? @default(false)
  is_trending Boolean? @default(false)
  name        String
  name_bn     String?
  name_en     String?
  priority    Int      @default(0)
  slug        String?
  status      String   @default("active")

  books                     Book[]
  coupons                   Coupon[]
  homepage_category_sections HomepageCategorySection[]

  @@map("categories")
}

model CmsPage {
  id              String   @id @default(uuid())
  content         String   @default("")
  created_at      DateTime @default(now())
  featured_image  String?
  seo_description String?
  seo_keywords    String?
  seo_title       String?
  slug            String   @unique
  status          String   @default("draft")
  title           String
  updated_at      DateTime @updatedAt

  @@map("cms_pages")
}

model CoinPackage {
  id          String   @id @default(uuid())
  bonus_coins Int      @default(0)
  coins       Int
  created_at  DateTime @default(now())
  is_active   Boolean  @default(true)
  is_featured Boolean  @default(false)
  name        String
  price       Float
  sort_order  Int      @default(0)
  updated_at  DateTime @updatedAt

  purchases CoinPurchase[]

  @@map("coin_packages")
}

model CoinPurchase {
  id             String   @id @default(uuid())
  coins_amount   Int
  created_at     DateTime @default(now())
  package_id     String?
  payment_method String   @default("card")
  payment_status String   @default("pending")
  price          Float
  transaction_id String?
  updated_at     DateTime @updatedAt
  user_id        String

  package CoinPackage? @relation(fields: [package_id], references: [id])

  @@map("coin_purchases")
}

model CoinTransaction {
  id           String   @id @default(uuid())
  amount       Int
  created_at   DateTime @default(now())
  description  String?
  expires_at   DateTime?
  reference_id String?
  source       String?
  type         String   @default("earn")
  user_id      String

  @@index([user_id, created_at])
  @@index([type, created_at])
  @@map("coin_transactions")
}

model CommentLike {
  id         String   @id @default(uuid())
  comment_id String
  created_at DateTime @default(now())
  user_id    String

  comment BookComment @relation(fields: [comment_id], references: [id])

  @@map("comment_likes")
}

model ContentAccessLog {
  id             String   @id @default(uuid())
  access_granted Boolean  @default(false)
  book_id        String
  content_type   String
  created_at     DateTime @default(now())
  denial_reason  String?
  ip_address     String?
  user_agent     String?
  user_id        String

  @@map("content_access_logs")
}

model ContentAccessToken {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  expires_at DateTime
  format     String
  token      String   @unique
  user_id    String

  @@map("content_access_tokens")
}

model ContentConsumptionTime {
  id         String   @id @default(uuid())
  book_id    String
  created_at DateTime @default(now())
  format     String
  seconds    Int      @default(0)
  user_id    String

  @@index([format, created_at])
  @@index([user_id, format, created_at])
  @@map("content_consumption_time")
}

model ContentEditRequest {
  id          String   @id @default(uuid())
  book_id     String
  created_at  DateTime @default(now())
  details     String?
  format      String?
  request_type String  @default("edit")
  reviewer_id String?
  status      String   @default("pending")
  updated_at  DateTime @updatedAt
  user_id     String

  @@map("content_edit_requests")
}

model ContentUnlock {
  id            String   @id @default(uuid())
  book_id       String
  coins_spent   Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  format        String
  status        String   @default("active")
  unlock_method String   @default("coin")
  user_id       String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id, format])
  @@index([user_id, format])
  @@map("content_unlocks")
}

model ContributorEarning {
  id                 String   @id @default(uuid())
  book_id            String
  created_at         DateTime @default(now())
  earned_amount      Float    @default(0)
  format             String
  fulfillment_amount Float    @default(0)
  order_id           String?
  order_item_id      String?
  content_unlock_id  String?
  percentage         Float    @default(0)
  role               String
  sale_amount        Float    @default(0)
  status             String   @default("pending")
  user_id            String

  order      Order?     @relation(fields: [order_id], references: [id])
  order_item OrderItem? @relation(fields: [order_item_id], references: [id])

  @@map("contributor_earnings")
}

model CouponUsage {
  id              String   @id @default(uuid())
  coupon_id       String
  created_at      DateTime @default(now())
  discount_amount Float    @default(0)
  order_id        String?
  subscription_id String?
  user_id         String

  coupon       Coupon            @relation(fields: [coupon_id], references: [id])
  order        Order?            @relation(fields: [order_id], references: [id])
  subscription UserSubscription? @relation(fields: [subscription_id], references: [id])

  @@map("coupon_usage")
}

model Coupon {
  id               String   @id @default(uuid())
  applies_to       String   @default("all")
  category_id      String?
  code             String   @unique
  created_at       DateTime @default(now())
  description      String?
  discount_type    String   @default("percentage")
  discount_value   Float    @default(0)
  end_date         DateTime?
  first_order_only Boolean  @default(false)
  min_order_amount Float?
  per_user_limit   Int?
  start_date       DateTime @default(now())
  status           String   @default("active")
  updated_at       DateTime @updatedAt
  usage_limit      Int?
  used_count       Int      @default(0)

  usages   CouponUsage[]
  books    CouponBook[]
  category Category?     @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@map("coupons")
}

model CouponBook {
  id         String @id @default(uuid())
  coupon_id  String
  book_id    String

  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  book   Book   @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([coupon_id, book_id])
  @@map("coupon_books")
}

model DailyBookStat {
  id             String   @id @default(uuid())
  book_id        String
  created_at     DateTime @default(now())
  purchases      Int      @default(0)
  reads          Int      @default(0)
  stat_date      DateTime @default(now())
  unique_readers Int      @default(0)
  views          Int      @default(0)

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("daily_book_stats")
}

model DefaultRevenueRule {
  id                          String   @id @default(uuid())
  created_at                  DateTime @default(now())
  format                      String
  fulfillment_cost_percentage Float    @default(0)
  narrator_percentage         Float    @default(0)
