{
  "info": {
    "name": "Boiaro Mobile API",
    "description": "Complete REST API collection for the Boiaro mobile app — covers auth, chapters (listing, coin unlock, gateway payment), ad management, and wallet.",
    "_postman_id": "boiaro-mobile-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",  "value": "http://localhost:3001/api/v1", "type": "string" },
    { "key": "token",    "value": "", "type": "string" },
    { "key": "bookId",   "value": "", "type": "string" },
    { "key": "trackId",  "value": "", "type": "string" },
    { "key": "purchaseId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Sign Up (with referral)",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.token) pm.collectionVariables.set('token', j.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Test User\",\n  \"referralCode\": \"ABCD1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.token) pm.collectionVariables.set('token', j.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.token) pm.collectionVariables.set('token', j.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<your-refresh-token>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Me (profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        }
      ]
    },
    {
      "name": "📚 Chapter Unlock Flow",
      "item": [
        {
          "name": "1. List Chapters (with unlock status)",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.chapters && j.chapters.length > 0) pm.collectionVariables.set('trackId', j.chapters[0].id);"], "type": "text/javascript" } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/chapters",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "chapters"]
            }
          },
          "description": "Returns all audiobook chapters for a book with per-user unlock status.\n\nResponse fields:\n- `pricing_mode`: 'per_chapter' | 'whole_book'\n- `book_coin_price`: coin cost for full-book unlock\n- `chapters[].is_unlocked`: true if user has access\n- `chapters[].is_free`: true for preview chapters\n- `chapters[].chapter_price_coins`: cost to unlock individually"
        },
        {
          "name": "2a. Unlock Chapter with Coins",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/chapters/{{trackId}}/unlock-coin",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{trackId}}", "unlock-coin"]
            }
          },
          "description": "Deducts `chapter_price` coins from the user's wallet and creates a `content_unlock` record.\n\nResponse:\n- `success`: true\n- `coins_spent`: coins deducted\n- `new_balance`: updated wallet balance\n- `already_unlocked`: true if chapter was already accessible"
        },
        {
          "name": "2b. Initiate Chapter Payment (SSLCommerz)",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.purchase_id) pm.collectionVariables.set('purchaseId', j.purchase_id);"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": \"{{bookId}}\",\n  \"gateway\": \"sslcommerz\",\n  \"success_redirect\": \"myapp://payment/success\",\n  \"fail_redirect\": \"myapp://payment/failed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chapters/{{trackId}}/initiate-payment",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{trackId}}", "initiate-payment"]
            }
          },
          "description": "Starts an SSLCommerz payment session for a chapter.\n\n`success_redirect` and `fail_redirect` can be mobile deep links (e.g. `myapp://payment/success`). The mobile app should open `gateway_url` in a WebView/browser.\n\nResponse:\n- `purchase_id`: save this to poll status later\n- `gateway_url`: open in WebView\n- `amount`: BDT amount"
        },
        {
          "name": "2c. Initiate Chapter Payment (bKash)",
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.purchase_id) pm.collectionVariables.set('purchaseId', j.purchase_id);"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": \"{{bookId}}\",\n  \"gateway\": \"bkash\",\n  \"success_redirect\": \"myapp://payment/success\",\n  \"fail_redirect\": \"myapp://payment/failed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chapters/{{trackId}}/initiate-payment",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{trackId}}", "initiate-payment"]
            }
          }
        },
        {
          "name": "3. Poll Payment Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chapters/payment-status/{{purchaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "payment-status", "{{purchaseId}}"]
            }
          },
          "description": "Poll this after the user returns from the payment gateway WebView.\n\nResponse:\n- `status`: 'pending' | 'completed' | 'failed'\n- `is_unlocked`: true when chapter access is granted\n\nPoll every 3–5 seconds until `is_unlocked` is true or `status` is 'failed'."
        },
        {
          "name": "4. Get My Unlocked Chapters",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/unlocked-chapters",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "unlocked-chapters"]
            }
          },
          "description": "Returns all chapters the authenticated user can play.\n\nResponse:\n- `full_book_unlocked`: true if the user bought the full audiobook\n- `unlocked_track_ids[]`: list of track IDs the user can stream\n- `unlocked_chapters[]`: track details with unlock timestamps"
        }
      ]
    },
    {
      "name": "📢 Ad Management",
      "item": [
        {
          "name": "Get Ad Settings",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ads/settings", "host": ["{{baseUrl}}"], "path": ["ads", "settings"] }
          },
          "description": "Public. Returns global ad system configuration.\n\nKey fields:\n- `system_enabled`: whether ads are active at all\n- `provider_type`: 'adsense' | 'none'\n- `rewarded_coins`: coins per rewarded ad view\n- `max_per_day`: daily rewarded ad limit per user\n- `cooldown_minutes`: wait time between rewarded ads"
        },
        {
          "name": "Get Active Banners",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ads/banners?placement=homepage_top&device=mobile",
              "host": ["{{baseUrl}}"],
              "path": ["ads", "banners"],
              "query": [
                { "key": "placement", "value": "homepage_top", "description": "Filter by placement key (optional)" },
                { "key": "device",    "value": "mobile",        "description": "Filter by device: mobile | tablet | desktop | all (optional)" }
              ]
            }
          },
          "description": "Public. Returns active image banners with their image URLs, destination links, and impression/click counts.\n\nOmit query params to get all active banners."
        },
        {
          "name": "Get Ad Placements",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ads/placements", "host": ["{{baseUrl}}"], "path": ["ads", "placements"] }
          },
          "description": "Public. Returns all enabled ad placement slots (e.g. homepage_top, book_detail_middle, etc.)."
        },
        {
          "name": "Get Rewarded Ad Status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ads/rewarded/status", "host": ["{{baseUrl}}"], "path": ["ads", "rewarded", "status"] }
          },
          "description": "Auth required. Check before showing the Watch Ad button.\n\nResponse:\n- `can_watch`: true if the user may watch an ad right now\n- `remaining`: how many more ads they can watch today\n- `cooldown_seconds_left`: seconds to wait (0 = ready)\n- `today_count` / `daily_limit`"
        },
        {
          "name": "Claim Rewarded Ad Reward",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placement\": \"mobile_player\",\n  \"ad_event_id\": \"ga_rewarded_abc123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ads/rewarded/claim", "host": ["{{baseUrl}}"], "path": ["ads", "rewarded", "claim"] }
          },
          "description": "Auth required. Call this AFTER the ad has been fully watched.\n\nResponse:\n- `success`: true\n- `reward`: coins awarded\n- `new_balance`: updated wallet balance\n- `remaining`: ads left today\n\nError codes:\n- 400 `daily_limit_reached`\n- 429 `cooldown` (too soon after last ad)"
        },
        {
          "name": "Record Banner Impression",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"banner_id\": \"<banner-uuid>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ads/impression", "host": ["{{baseUrl}}"], "path": ["ads", "impression"] }
          },
          "description": "Fire when a banner enters the viewport. Auth is optional. Increments the banner's impression counter."
        },
        {
          "name": "Record Banner Click",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"banner_id\": \"<banner-uuid>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ads/click", "host": ["{{baseUrl}}"], "path": ["ads", "click"] }
          },
          "description": "Fire when the user taps a banner. Auth is optional. Increments the click counter."
        }
      ]
    },
    {
      "name": "💰 Wallet",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/wallet", "host": ["{{baseUrl}}"], "path": ["wallet"] }
          }
        },
        {
          "name": "Get Coin Settings",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/wallet/coin-settings", "host": ["{{baseUrl}}"], "path": ["wallet", "coin-settings"] }
          },
          "description": "Public. Returns conversion ratio, daily ad limit, cooldown, etc."
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallet/transactions?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["wallet", "transactions"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Claim Daily Login Reward",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/wallet/claim-daily", "host": ["{{baseUrl}}"], "path": ["wallet", "claim-daily"] }
          },
          "description": "Can only be called once per calendar day. Reward amount comes from `coin_daily_login_reward` platform setting."
        },
        {
          "name": "Claim Ad Reward (legacy)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placement\": \"mobile_player\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/wallet/claim-ad", "host": ["{{baseUrl}}"], "path": ["wallet", "claim-ad"] }
          },
          "description": "Legacy endpoint. Prefer `/ads/rewarded/claim` for new integrations — it supports cooldown checking and ad event tracking."
        },
        {
          "name": "Unlock Full Book with Coins",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": \"{{bookId}}\",\n  \"format\": \"audiobook\",\n  \"coin_cost\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/wallet/unlock", "host": ["{{baseUrl}}"], "path": ["wallet", "unlock"] }
          },
          "description": "Unlock an entire book format (e.g. `audiobook`) for the user. For per-chapter unlocks, use `/chapters/:trackId/unlock-coin` instead."
        }
      ]
    },
    {
      "name": "📖 Books & Content",
      "item": [
        {
          "name": "List Books",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Book by Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":slug"],
              "variable": [{ "key": "slug", "value": "my-book-slug" }]
            }
          }
        },
        {
          "name": "Check Content Access",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/access/{{bookId}}/audiobook",
              "host": ["{{baseUrl}}"],
              "path": ["access", "{{bookId}}", "audiobook"]
            }
          },
          "description": "Returns whether the current user can access a specific book format."
        }
      ]
    }
  ]
}
