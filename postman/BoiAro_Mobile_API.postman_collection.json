{
  "info": {
    "name": "BoiAro Mobile API — Complete Reference",
    "description": "All REST endpoints for BoiAro mobile app integration.\n\n## Setup\n1. Set `base_url` variable (e.g. `https://api.boiaro.com` — no trailing slash)\n2. Run **Login** — it auto-sets `{{access_token}}`\n3. All protected requests use `Authorization: Bearer {{access_token}}`\n\n## Notes\n- Rating and total_reads are always live-computed from DB\n- For free books all tracks have `is_preview: true`, `chapter_price: null`\n- Chapter coin price is always validated server-side; send best-effort `coin_cost`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:3001" },
    { "key": "access_token", "value": "" },
    { "key": "book_id",      "value": "" },
    { "key": "order_id",     "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "description": "All endpoints under /api/v1/auth",
      "item": [
        {
          "name": "Sign Up",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/signup" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Secret123!\",\n  \"display_name\": \"Rahim\"\n}" },
            "description": "Creates a new user account. Auto-generates a referral code. Returns `{ message }`.\nCall /auth/login after signup to get tokens." }
        },
        {
          "name": "Login ✦ sets access_token",
          "event": [{ "listen": "test", "script": { "exec": ["var j=pm.response.json(); if(j.access_token) pm.collectionVariables.set('access_token',j.access_token);"] } }],
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Secret123!\"\n}" },
            "description": "Returns:\n```json\n{\n  \"access_token\": \"eyJ...\",\n  \"refresh_token\": \"eyJ...\",\n  \"expires_in\": 3600,\n  \"user_id\": \"uuid\",\n  \"user\": { \"id\", \"email\", \"display_name\", \"avatar_url\", ... }\n}\n```\nThe test script auto-sets `{{access_token}}`." }
        },
        {
          "name": "Refresh Token ✦ sets access_token",
          "event": [{ "listen": "test", "script": { "exec": ["var j=pm.response.json(); if(j.access_token) pm.collectionVariables.set('access_token',j.access_token);"] } }],
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"<refresh_token>\"\n}" },
            "description": "Issue new access + refresh tokens before expiry." }
        },
        {
          "name": "Logout",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/logout" },
            "description": "Invalidates session server-side. Returns `{ message }`." }
        },
        {
          "name": "Get Current User",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/auth/me" },
            "description": "Returns full user object with profile and roles array." }
        },
        {
          "name": "Request Password Reset",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/reset-password" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" } }
        },
        {
          "name": "Confirm Password Reset",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/reset-password-confirm" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewSecret123!\"\n}" },
            "description": "Accepts `otp` OR `token`. Resets the user's password." }
        },
        {
          "name": "Update Password (Logged In)",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/update-password" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"NewSecret123!\"\n}" } }
        },
        {
          "name": "Google Login",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/social/google" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_token\": \"<google_id_token>\"\n}" },
            "description": "Pass Google `id_token` from Sign-In SDK. Also accepts `idToken` or `access_token` / `accessToken`.\nReturns same shape as Login." }
        },
        {
          "name": "Facebook Login",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/social/facebook" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"access_token\": \"<facebook_access_token>\"\n}" },
            "description": "Pass Facebook `access_token`. Also accepts `accessToken`.\nReturns same shape as Login." }
        },
        {
          "name": "Phone — Send OTP",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/phone/send-otp" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+8801XXXXXXXXX\"\n}" },
            "description": "Sends OTP via SMS. Rate-limited to 1 per 60 seconds per phone number." }
        },
        {
          "name": "Phone — Verify OTP",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/auth/phone/verify-otp" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+8801XXXXXXXXX\",\n  \"otp\": \"123456\"\n}" },
            "description": "Returns tokens on success — same shape as Login." }
        }
      ]
    },

    {
      "name": "👤 Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/profile/" },
            "description": "Returns: `display_name`, `avatar_url`, `phone`, `bio`, `address`, `city`, `district`, referral info." }
        },
        {
          "name": "Update Profile",
          "request": { "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/v1/profile/" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"display_name\": \"Rahim Uddin\",\n  \"phone\": \"+8801XXXXXXXXX\",\n  \"bio\": \"Book lover\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Dhaka\",\n  \"district\": \"Dhaka\"\n}" } }
        },
        {
          "name": "Upload Profile Photo",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/profile/upload-image" },
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "description": "JPG/PNG/WebP, max 5 MB.\nReturns: `{ success, avatar_url, storage }`" }
        },
        {
          "name": "Get My Roles",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/profile/roles" },
            "description": "Returns `{ roles: [{ role, ... }] }`. Role values: `user`, `author`, `narrator`, `publisher`, `admin`, `rj`." }
        }
      ]
    },

    {
      "name": "📚 Books",
      "item": [
        {
          "name": "List Books",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/?limit=20",
              "query": [
                { "key": "limit",        "value": "20",  "description": "Items per page (default 20)" },
                { "key": "cursor",       "value": "",    "description": "Last book ID for pagination", "disabled": true },
                { "key": "search",       "value": "",    "description": "Title / description search", "disabled": true },
                { "key": "category_id",  "value": "",    "description": "Filter by category UUID", "disabled": true },
                { "key": "isFeatured",   "value": "",    "description": "true | false", "disabled": true },
                { "key": "isBestseller", "value": "",    "description": "true | false", "disabled": true },
                { "key": "isFree",       "value": "",    "description": "true | false", "disabled": true },
                { "key": "language",     "value": "",    "description": "e.g. bn", "disabled": true },
                { "key": "authorId",     "value": "",    "description": "Filter by author UUID", "disabled": true },
                { "key": "publisherId",  "value": "",    "description": "Filter by publisher UUID", "disabled": true },
                { "key": "narrator",     "value": "",    "description": "Filter by narrator UUID", "disabled": true }
              ]
            },
            "description": "Returns `{ books: [...], nextCursor }`. Each book includes `author`, `publisher`, `category`, `formats`." }
        },
        {
          "name": "Get Book by ID",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}" },
            "description": "Full book detail. Key fields:\n- `rating` — live avg from approved reviews\n- `reviews_count` — live count\n- `total_reads` — live count from BookRead table\n- `is_free` — all chapters free if true\n- `formats[]` — each format has `price`, `is_available`, `preview_percentage`\n- `author.followed`, `publisher.followed`, `narrator.followed` — whether current user follows them" }
        },
        {
          "name": "Get Book by Slug",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/slug/:slug",
              "variable": [{ "key": "slug", "value": "bhoot-bou" }] },
            "description": "Same response shape as Get Book by ID." }
        },
        {
          "name": "Get Book Categories",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/categories/list" },
            "description": "Returns all active categories, ordered by priority." }
        },
        {
          "name": "Get Audiobook Tracks",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/tracks" },
            "description": "```json\n{\n  \"tracks\": [\n    {\n      \"id\": \"uuid\",\n      \"track_number\": 1,\n      \"title\": \"Chapter 1\",\n      \"duration\": \"12:34\",\n      \"is_preview\": true,\n      \"chapter_price\": null,\n      \"media_type\": \"audio\",\n      \"status\": \"active\"\n    }\n  ]\n}\n```\n\n⚠️ **Free book rule:** When `book.is_free = true` OR `audiobook.price = 0`, ALL tracks are returned with `is_preview: true` and `chapter_price: null` — no payment required, app needs no special handling." }
        },
        {
          "name": "Register Book Read/View",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/read" },
            "description": "Call when user opens a book. Increments `total_reads`.\n- No auth required\n- If `Authorization` header present, also creates a `BookRead` record for the user\n\nResponse: `{ success: true, total_reads: 42 }`" }
        },
        {
          "name": "Get Book Reviews",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/reviews?limit=20",
              "query": [{ "key": "limit", "value": "20" }] } }
        },
        {
          "name": "Post / Update Review",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/reviews" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excellent book!\"\n}" },
            "description": "Creates or updates the user's review. Review starts in `pending` status — admin must approve. Rating: 1–5." }
        },
        {
          "name": "Add Bookmark / Wishlist",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/bookmarks" },
            "description": "Returns `{ bookmarked: true }`." }
        },
        {
          "name": "Remove Bookmark",
          "request": { "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/bookmarks" },
            "description": "Returns `{ bookmarked: false }`." }
        },
        {
          "name": "Check Bookmark Status",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/books/{{book_id}}/bookmark" },
            "description": "Returns `{ bookmarked: true | false }`." }
        }
      ]
    },

    {
      "name": "🎧 Content (Audio & Ebook URLs)",
      "item": [
        {
          "name": "Get Single Audio Track URL",
          "request": { "method": "POST", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/content/audio-url" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\",\n  \"track_number\": 1\n}" },
            "description": "Returns a time-limited playback URL for one audio track. `track_number` defaults to 1.\n\n```json\n{ \"signed_url\": \"https://...\", \"expires_in\": 300 }\n```\n\n⚠️ No access check — verify `is_preview` / unlock status from the tracks endpoint before calling." }
        },
        {
          "name": "Get All Audio URLs (Batch)",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/content/batch-audio-urls" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\"\n}" },
            "description": "Fetches signed URLs for ALL active tracks in one round-trip.\n\n```json\n{\n  \"tracks\": [\n    { \"track_number\": 1, \"signed_url\": \"https://...\", \"expires_in\": 300 }\n  ]\n}\n```" }
        },
        {
          "name": "Get Ebook File URL",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/content/ebook-url" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\"\n}" },
            "description": "Validates access (purchase / subscription / free), then returns a presigned S3 URL.\n\n```json\n{ \"signed_url\": \"https://...\", \"expires_in\": 3600 }\n```" }
        },
        {
          "name": "Download Ebook File (Stream)",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/content/download/ebook/{{book_id}}" },
            "description": "Streams the ebook binary directly. Use for in-app offline download." }
        }
      ]
    },

    {
      "name": "🔓 Access Control",
      "item": [
        {
          "name": "Check Book Access",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/access/check" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\",\n  \"format\": \"audiobook\"\n}" },
            "description": "Check if user has full access to a book+format.\n\n`format`: `ebook`, `audiobook`, `hardcopy`\n\nResponse:\n```json\n{\n  \"has_access\": true,\n  \"access_type\": \"free\" | \"purchase\" | \"subscription\" | \"coin_unlock\",\n  \"expires_at\": null\n}\n```\n\nFor `is_free = true` books: always `has_access: true, access_type: \"free\"`." }
        },
        {
          "name": "Check Preview Eligibility",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/access/preview-eligibility?book_id={{book_id}}&format=ebook",
              "query": [
                { "key": "book_id", "value": "{{book_id}}" },
                { "key": "format",  "value": "ebook", "description": "ebook | audiobook" }
              ]
            },
            "description": "Returns whether a book format can be previewed and the preview limits." }
        },
        {
          "name": "Unlock Content with Coins",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/wallet/unlock" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\",\n  \"format\": \"audiobook_chapter_<track_uuid>\",\n  \"coin_cost\": 100\n}" },
            "description": "Unlock content by spending coins.\n\n**`format` values:**\n- `ebook` — full ebook access\n- `audiobook` — full audiobook access\n- `audiobook_chapter_<track_id>` — single chapter (server ALWAYS uses DB price; `coin_cost` is ignored for chapters)\n- `premium_voice` — AI TTS voice unlock\n\n**Responses:**\n- `{ success: true, message, new_balance }` — unlocked\n- `{ already_unlocked: true }` — was already unlocked\n\n**Errors:**\n- 400 `Insufficient coins`\n- 400 `Chapter not found`\n- 403 `Subscription required`" }
        }
      ]
    },

    {
      "name": "💰 Wallet & Coins",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/wallet/" },
            "description": "Returns `{ balance, total_earned, total_spent }`." }
        },
        {
          "name": "Get Transaction History",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/wallet/transactions?limit=50",
              "query": [{ "key": "limit", "value": "50", "description": "Max 100, default 50" }] },
            "description": "Each item: `id`, `amount`, `type` (earn/spend/bonus), `description`, `source`, `created_at`, `expires_at`." }
        },
        {
          "name": "Claim Daily Login Reward",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/wallet/claim-daily" },
            "description": "Awards 10 coins once per calendar day.\nResponse: `{ reward: 10, message: \"...\", new_balance: 42 }`." }
        },
        {
          "name": "Claim Ad Reward",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/wallet/claim-ad" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"placement\": \"audiobook_{{book_id}}\"\n}" },
            "description": "Awards 1 coin per ad view. Max 10 ad rewards per day. `placement` is optional context.\nResponse: `{ reward: 1, message: \"...\", new_balance: 43 }`." }
        },
        {
          "name": "Get Coin Settings",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/wallet/coin-settings" },
            "description": "Platform-wide coin config:\n```json\n{\n  \"system_enabled\": true,\n  \"unlock_enabled\": true,\n  \"conversion_ratio\": 0.10,\n  \"coin_ad_reward\": 1,\n  \"daily_limit\": 50,\n  \"ads_per_quick_unlock\": 5,\n  \"bonus_per_session\": 5,\n  \"ad_cooldown_minutes\": 5\n}\n```" }
        },
        {
          "name": "Get Coin Packages",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/coin-packages/" },
            "description": "```json\n{\n  \"packages\": [\n    {\n      \"id\": \"uuid\",\n      \"name\": \"Starter Pack\",\n      \"coins\": 100,\n      \"bonus_coins\": 10,\n      \"price\": 50.00,\n      \"is_active\": true,\n      \"is_featured\": false\n    }\n  ]\n}\n```" }
        }
      ]
    },

    {
      "name": "👑 Subscriptions",
      "item": [
        {
          "name": "Get Plans",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/subscriptions/plans" },
            "description": "```json\n{\n  \"plans\": [{\n    \"id\": \"uuid\",\n    \"name\": \"Monthly Pro\",\n    \"description\": \"Full access 30 days\",\n    \"price\": 99,\n    \"duration_days\": 30,\n    \"features\": [\"Unlimited ebooks\", \"All audiobooks\"],\n    \"is_active\": true,\n    \"is_featured\": false\n  }]\n}\n```" }
        },
        {
          "name": "Get Active Subscription",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/subscriptions/active" },
            "description": "Returns current active subscription or `{ subscription: null }` if none." }
        },
        {
          "name": "Get All My Subscriptions",
          "request": { "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/subscriptions/my" },
            "description": "Full subscription history. Each item: `id`, `plan_id`, `status` (pending/active/failed/cancelled), `start_date`, `end_date`, `amount_paid`." }
        },
        {
          "name": "Subscribe — Free / Coupon",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/subscriptions/subscribe" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plan_id\": \"<plan_uuid>\",\n  \"coupon_code\": \"FREE100\"\n}" },
            "description": "If coupon makes amount = ৳0, activates immediately:\n```json\n{\n  \"requires_payment\": false,\n  \"subscription\": { \"id\": \"uuid\", \"status\": \"active\", ... }\n}\n```" }
        },
        {
          "name": "Subscribe — Paid (SSLCommerz)",
          "request": { "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/subscriptions/subscribe" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plan_id\": \"<plan_uuid>\",\n  \"payment_method\": \"sslcommerz\"\n}" },
            "description": "For paid plans:\n```json\n{\n  \"requires_payment\": true,\n  \"gateway_url\": \"https://sandbox.sslcommerz.com/...\",\n  \"subscription_id\": \"uuid\",\n  \"transaction_id\": \"SUB-...\"\n}\n```\nOpen `gateway_url` in WebView. Subscription activates automatically via payment callback." }
        }
      ]
    },

    {
      "name": "🛒 Orders",
      "item": [
        {
          "name": "Get Payment Gateways",
          "request": { "method": "GET", "auth": { "type": "noauth" },
            "url": { "raw": "{{base_url}}/api/v1/orders/payment-gateways" },
            "description": "Returns enabled gateways. Use `gateway_key` in create-order body." }
