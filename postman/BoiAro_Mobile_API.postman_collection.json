        },
        {
          "name": "Save Listening Progress",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/api/v1/progress/listening" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": \"{{book_id}}\",\n  \"track_number\": 2,\n  \"position_seconds\": 345,\n  \"total_seconds\": 1800\n}" },
            "description": "Save or update audiobook listening position."
          }
        }
      ]
