        {
          "name": "Get My Badges",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/gamification/badges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gamification", "badges"]
            },
            "description": "Auth required. Returns badges already earned by the current user."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"badges\": [\n    { \"id\": \"badge-1\", \"key\": \"first_unlock\", \"title\": \"First Unlock\", \"description\": \"Unlocked your first book\", \"coin_reward\": 5, \"earned_at\": \"2026-05-01T10:00:00.000Z\" }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Get Badge Definitions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/gamification/badges/definitions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "gamification", "badges", "definitions"]
            },
            "description": "Auth required (despite being catalog data, route currently requires a session). Returns all active badge definitions — what badges exist and the condition needed to earn each, useful for an in-app \"Achievements\" screen.\n\n**condition_type values:** `unlock_count`, `streak`, `ad_count`, `daily_login_count`, `referral_count`, `first_unlock`, `first_referral`."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"definitions\": [\n    { \"id\": \"badge-1\", \"key\": \"first_unlock\", \"title\": \"First Unlock\", \"description\": \"Unlock your first book\", \"condition_type\": \"first_unlock\", \"condition_value\": null, \"coin_reward\": 5, \"is_active\": true, \"sort_order\": 1 },\n    { \"id\": \"badge-2\", \"key\": \"streak_7\", \"title\": \"7-Day Streak\", \"description\": \"Read 7 days in a row\", \"condition_type\": \"streak\", \"condition_value\": 7, \"coin_reward\": 20, \"is_active\": true, \"sort_order\": 2 }\n  ]\n}"
            }
          ]
