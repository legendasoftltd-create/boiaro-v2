              "body": "{\n  \"leaderboard\": [\n    { \"rank\": 1, \"user_id\": \"user-uuid-1\", \"total_points\": 980, \"display_name\": \"Rafiq\", \"avatar_url\": \"https://.../avatar1.webp\" },\n    { \"rank\": 2, \"user_id\": \"user-uuid-2\", \"total_points\": 750, \"display_name\": \"Mim\", \"avatar_url\": null }\n  ]\n}"
